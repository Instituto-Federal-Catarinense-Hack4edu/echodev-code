# EchoDev: variáveis dos scripts administrativos (scripts/*.py). Copie para .env na raiz.
# Nunca faça commit do .env nem do JSON da conta de serviço.
FIREBASE_PROJECT_ID=SEU-PROJETO
# JSON da conta de serviço, caminho relativo à raiz do repositório (ex.: api/firebase-service-account.json).
# Não é preciso com --emulators.
FIREBASE_CREDENTIALS_FILE=api/firebase-service-account.json
# Senha dos usuários de teste criados por `npm run seed:dev` (12+ caracteres).
DEV_USERS_PASSWORD=
# E-mail do professor de teste (vai para teacherAllowlist).
DEV_TEACHER_EMAIL=professor.teste@echodev.test
