# EchoDev: variáveis usadas pelos scripts administrativos (scripts/*.py).
# Copie para .env na raiz e preencha. Nunca faça commit do .env.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Senha usada pelos usuários de teste criados por `npm run seed:dev`.
DEV_USERS_PASSWORD=
# E-mail do professor de teste (vai para teacher_allowlist).
DEV_TEACHER_EMAIL=professor.teste@echodev.test
