# Copie para web/.env.local. Só URL e chave PÚBLICA do Supabase aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (antiga) ou "publishable" (nova), a que o painel mostrar.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL da API Python (FastAPI).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Mostra o login por e-mail e senha (somente desenvolvimento).
NEXT_PUBLIC_DEV_LOGIN=false
# Mostra o botão "Entrar com Google" (ative só depois de configurar o provedor no Supabase).
NEXT_PUBLIC_GOOGLE_LOGIN=false
