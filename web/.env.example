# Copie para web/.env.local. Configuração web do Firebase (Console > Configurações do
# projeto > Seus apps > app Web). Estes valores são públicos; quem protege os dados são as
# regras em firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=SEU-PROJETO
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=SEU-PROJETO.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# true = usa os emuladores locais (npm run dev:emulators faz isso sozinho).
NEXT_PUBLIC_FIREBASE_EMULATORS=false
# URL da API Python (FastAPI).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Mostra o botão "Entrar com Google" (ative o provedor Google no Firebase Authentication antes).
NEXT_PUBLIC_GOOGLE_LOGIN=false
