# Copie para api/.env. Nunca faça commit do .env nem do JSON da conta de serviço.
FIREBASE_PROJECT_ID=SEU-PROJETO
# JSON da conta de serviço (Console > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada), caminho relativo à pasta api/. Vazio com os emuladores.
FIREBASE_CREDENTIALS_FILE=firebase-service-account.json
# Emuladores locais (npm run dev:emulators já define estes dois).
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
# Origem(ns) exata(s) do web/, sem barra no fim, separadas por vírgula. Nunca "*".
WEB_ORIGIN=http://localhost:3000
# Segredo enviado no cabeçalho X-Cron-Secret pelo agendador externo (POST /cron/purge).
CRON_SECRET=
# IA do resumo e do quiz: mock (sem chave, padrão), gemini (gratuito) ou anthropic (pago).
LLM_PROVIDER=mock
# Modelo do provedor escolhido. gemini: gemini-3.6-flash (estável, com plano gratuito).
# anthropic: claude-opus-5-5.
LLM_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=90

# gemini: chave gratuita em https://aistudio.google.com (Get API key), sem cartão.
# No plano gratuito o Google pode usar o texto enviado para melhorar os produtos dele.
GEMINI_API_KEY=
# Quando a cota gratuita do LLM_MODEL acaba (erro 429), a chamada passa para este modelo.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# anthropic (pago)
ANTHROPIC_API_KEY=
# Esforço do modelo (low, medium, high, xhigh, max). Não existe mais "temperature" na API.
LLM_EFFORT=medium
# Se o modelo recusar por engano, a API tenta outro modelo na mesma chamada.
LLM_FALLBACKS=true
ENVIRONMENT=development
