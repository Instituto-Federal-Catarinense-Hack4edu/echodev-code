# Copie para api/.env. Nunca faça commit do .env.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Usada SOMENTE em /cron/purge e na exclusão da própria conta.
SUPABASE_SERVICE_ROLE_KEY=
# Origem(ns) exata(s) do web/, sem barra no fim, separadas por vírgula. Nunca "*".
WEB_ORIGIN=http://localhost:3000
# Segredo enviado no cabeçalho X-Cron-Secret pelo agendador externo.
CRON_SECRET=
# mock (sem chave, padrão) ou anthropic
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=90
# Esforço do modelo (low, medium, high, xhigh, max). Não existe mais "temperature" na API.
LLM_EFFORT=medium
# Se o modelo recusar por engano, a API tenta outro modelo na mesma chamada.
LLM_FALLBACKS=true
ENVIRONMENT=development
